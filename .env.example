# Copy to apps/web/.env.local — Next.js reads env files from the app directory.
# Every variable below except NODE_ENV / PORT is REQUIRED: the server
# refuses to start without it (see docs/ENV.md, RULES R18). There are no fallbacks.

# Node environment
NODE_ENV=development
PORT=3000

# Database — pglite://memory for an in-memory PGlite (migrated and seeded on start, empty
# after a restart), or a Neon URL. Any non-pglite URL goes to Neon's HTTP driver, so a plain
# local Postgres (localhost:5432) does not work.
DATABASE_URL=pglite://memory

# Auth
BETTER_AUTH_SECRET=your_super_secret_key_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Object storage — any S3-compatible provider (production: Backblaze B2)
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=your_b2_application_key_id
S3_SECRET_ACCESS_KEY=your_b2_application_key
S3_BUCKET=college-ess-assets

# Reminder Engine & Push Notifications
# Generate keys: pnpm --filter @clg-ess/web exec web-push generate-vapid-keys
TICK_SECRET=your_secure_shared_tick_secret_for_scheduler
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key_keep_secret
VAPID_SUBJECT=mailto:admin@clg.edu
